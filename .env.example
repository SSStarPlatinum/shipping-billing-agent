# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改。所有项都有默认值，不配置也能跑。
# ---------------------------------------------------------------------------

# ---------- 记账主体（决定 AR/AP 视角）----------
# 谁在记账，就以谁的视角判断应收/应付
ACCOUNTING_ENTITY=NEPTUNE SHIPPING LIMITED

# ---------- OCR ----------
OCR_API_URL=https://gateway.pltplt.com/ai/process
OCR_TASK=orderChange
# auto | api | cache | text
OCR_MODE=auto
# api 模式必需：OCR 服务能下载到文件的公网前缀，会拼成 {base}/{文件名}
# OCR_PUBLIC_BASE_URL=https://your-file-host/bills
# 或者用文件名 -> URL 的映射表
# OCR_URL_MAP=config/ocr_urls.json

# ---------- LLM（可选增强，不配则纯规则）----------
LLM_ENABLED=false
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx

# ---------- 业务阈值 ----------
# 低于该置信度转人工
REVIEW_CONFIDENCE=0.55
LEDGER_PATH=data/ledger/existing_bills.json
